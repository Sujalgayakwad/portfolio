# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# If MongoDB is not running locally, the server automatically uses local persistent storage fallback!
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_cms

# Authentication
JWT_SECRET=replace_with_your_super_secret_jwt_key_here
ADMIN_EMAIL=admin@sujal.dev
ADMIN_PASSWORD=admin123

# Frontend (Vite)
VITE_API_URL=/api
